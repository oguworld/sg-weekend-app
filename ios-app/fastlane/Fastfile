require 'base64'
require 'tmpdir'

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight for beta testing"
  lane :deploy do
    setup_ci if ENV['CI']

    cert_path = File.join(Dir.tmpdir, "dist.p12")
    File.binwrite(cert_path, Base64.decode64(ENV['DIST_CERT_BASE64']))
    import_certificate(
      certificate_path:     cert_path,
      certificate_password: ENV['DIST_CERT_PASSWORD'],
      keychain_name:        "fastlane_tmp_keychain",
      keychain_password:    ""
    )

    profile_path = File.join(Dir.tmpdir, "profile.mobileprovision")
    File.binwrite(profile_path, Base64.decode64(ENV['PROVISION_PROFILE_BASE64']))
    install_provisioning_profile(path: profile_path)

    update_code_signing_settings(
      use_automatic_signing: false,
      team_id:               ENV['APPLE_TEAM_ID'],
      bundle_identifier:     "app.dosuru",
      code_sign_identity:    "Apple Distribution",
      profile_name:          "dosuru_appstore",
      path:                  "ios/App/App.xcodeproj"
    )

    app_version   = ENV['APP_VERSION'] || "1.1"
    release_notes = ENV['RELEASE_NOTES'] || "バグ修正とパフォーマンス改善"

    build_app(
      workspace:      "ios/App/App.xcworkspace",
      scheme:         "App",
      export_method:  "app-store",
      xcargs:         "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_STYLE=Manual CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']} MARKETING_VERSION=#{app_version}",
      export_options: {
        teamID:               ENV['APPLE_TEAM_ID'],
        provisioningProfiles: { "app.dosuru" => "dosuru_appstore" }
      }
    )

    # 設計書195: 「Contents.jsonに書いた」だけでなく「実際にxcodebuildがコンパイルした
    # Assets.carに含まれている」ことを継続的に確認するための診断ステップ。あくまでログ出力
    # 目的のため、失敗してもデプロイ全体を止めないようbegin/rescueで包む。
    begin
      archive_glob = File.expand_path("~/Library/Developer/Xcode/Archives/**/*.xcarchive")
      archives = Dir.glob(archive_glob).sort_by { |p| File.mtime(p) }
      if archives.empty?
        UI.important("[icon-check] No .xcarchive found under #{archive_glob}, skipping Assets.car diagnostic")
      else
        latest_archive = archives.last
        assets_car = Dir.glob(File.join(latest_archive, "Products", "Applications", "*.app", "Assets.car")).first
        if assets_car.nil? || !File.exist?(assets_car)
          UI.important("[icon-check] Assets.car not found under #{latest_archive}, skipping diagnostic")
        else
          UI.message("[icon-check] Inspecting #{assets_car}")
          dump = sh("xcrun assetutil --info '#{assets_car}' || true", log: false)
          matched_lines = dump.lines.select { |l| l =~ /20x20|"Name":"AppIcon-20|Notification/i }
          if matched_lines.empty?
            UI.important("[icon-check] No 20x20 related entries found in Assets.car output (this may indicate the Notifications icon is still missing)")
          else
            UI.message("[icon-check] 20x20-related Assets.car entries:")
            matched_lines.each { |l| UI.message("[icon-check] #{l.strip}") }
          end
        end
      end
    rescue => e
      UI.important("[icon-check] Diagnostic step failed (non-fatal, continuing deploy): #{e.message}")
    end

    api_key = app_store_connect_api_key(
      key_id:      ENV['ASC_KEY_ID'],
      issuer_id:   ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_PRIVATE_KEY']
    )

    upload_to_testflight(
      api_key:                           api_key,
      app_identifier:                    "app.dosuru",
      skip_waiting_for_build_processing: true,
      distribute_external:               false,
      notify_external_testers:           false
    )
  end

  # 設計書223: App Store本番審査提出の自動化（workflow_dispatchのみ、release/deployレーンとは完全分離）。
  # 証明書インポート～build_appまでは上記deployレーンと同一の手順を踏み、最後にTestFlightアップロード
  # ではなくdeliverで審査提出まで行う。既存のdeployレーン・TestFlight配信フローには一切変更を加えない。
  desc "Build and submit for App Store review (fully automatic, workflow_dispatch only)"
  lane :release_production do
    setup_ci if ENV['CI']

    cert_path = File.join(Dir.tmpdir, "dist.p12")
    File.binwrite(cert_path, Base64.decode64(ENV['DIST_CERT_BASE64']))
    import_certificate(
      certificate_path:     cert_path,
      certificate_password: ENV['DIST_CERT_PASSWORD'],
      keychain_name:        "fastlane_tmp_keychain",
      keychain_password:    ""
    )

    profile_path = File.join(Dir.tmpdir, "profile.mobileprovision")
    File.binwrite(profile_path, Base64.decode64(ENV['PROVISION_PROFILE_BASE64']))
    install_provisioning_profile(path: profile_path)

    update_code_signing_settings(
      use_automatic_signing: false,
      team_id:               ENV['APPLE_TEAM_ID'],
      bundle_identifier:     "app.dosuru",
      code_sign_identity:    "Apple Distribution",
      profile_name:          "dosuru_appstore",
      path:                  "ios/App/App.xcodeproj"
    )

    app_version = ENV['APP_VERSION'] || "1.1"

    build_app(
      workspace:      "ios/App/App.xcworkspace",
      scheme:         "App",
      export_method:  "app-store",
      xcargs:         "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']} CODE_SIGN_STYLE=Manual CURRENT_PROJECT_VERSION=#{ENV['BUILD_NUMBER']} MARKETING_VERSION=#{app_version}",
      export_options: {
        teamID:               ENV['APPLE_TEAM_ID'],
        provisioningProfiles: { "app.dosuru" => "dosuru_appstore" }
      }
    )

    # 既存deployレーンと同じApp Store Connect API認証情報を使う。
    # 注意: このAPIキーがdeliver（審査提出）に必要な権限（App Manager以上）を
    # 持っているかは未確認。権限不足の場合はここでエラーになる（ビルド自体は成功済みのため
    # TestFlightには影響しない）。権限エラーが出た場合は、App Store Connect
    # （ユーザー: WILLOA PTE. LTD.、Team ID: 4P3SWV4X5U）で新しいAPIキーをApp Manager以上の
    # ロールで発行し、GitHub SecretsのASC_KEY_ID/ASC_ISSUER_ID/ASC_PRIVATE_KEYを更新すること。
    api_key = app_store_connect_api_key(
      key_id:      ENV['ASC_KEY_ID'],
      issuer_id:   ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_PRIVATE_KEY']
    )

    # メタデータ・スクリーンショットはリポジトリ管理にしていないため、
    # App Store Connect側に既存のメタデータ（説明文・スクリーンショット等、
    # 既にアプリ公開時に設定済み）をそのまま使う。今回自動化するのは
    # 「次のビルドの審査提出」のみで、メタデータ変更は引き続き人間が
    # App Store Connect画面で行う。
    #
    # 設計書224（拡張）: ENV['RELEASE_NOTES']が指定された場合のみ、
    # App Store Connectの「新機能」欄（ja）をdeliver経由で更新する。
    #
    # 2026-10-10判明: skip_metadata:trueのままrelease_notesを渡しても、
    # fastlane deliverはメタデータアップロードのステップ自体を丸ごとスキップするため
    # 「新機能」欄は更新されない（Fastfile内の旧コメントの記述は誤り、実機ログで確認済み）。
    # さらに「新機能」欄が空のまま審査提出するとApple側が
    # "You must provide a value for the attribute 'whatsNew'" で提出自体を拒否する。
    # そのため release_notes が指定された場合は skip_metadata を明示的に false にする
    # （skip_screenshots:true は維持するため、スクリーンショット自体への影響はない）。
    release_notes = ENV['RELEASE_NOTES']
    has_release_notes = !(release_notes.nil? || release_notes.strip.empty?)

    deliver_options = {
      api_key:                     api_key,
      app_identifier:              "app.dosuru",
      skip_metadata:                !has_release_notes,
      skip_screenshots:             true,
      skip_binary_upload:           false,
      submit_for_review:            true,
      automatic_release:            true,
      force:                        true,
      # App Store Connect APIキー認証ではprecheckがIn-app purchasesを確認できず
      # 例外で落ちるfastlane既知の制限（本アプリはIn-app purchases非搭載のため
      # このチェック自体が不要）。2026-10-10、本番審査提出が毎回ここで失敗していたため追加。
      run_precheck_before_submit:   false
    }

    if has_release_notes
      deliver_options[:release_notes] = { "ja" => release_notes }
    end

    deliver(deliver_options)
  end

  # 設計書224（拡張、機能2）: App Store Connect上に人間が事前に用意した既存ドラフト／ビルドを
  # そのまま審査提出する専用レーン。build_app・証明書インポート等の一切のビルド関連処理を
  # 行わない（新規ビルドを作らないため不要）。skip_binary_upload:trueにより、deliverは
  # バイナリをアップロードせず、App Store Connect上に既にあるビルドを審査提出対象とする。
  desc "Submit an existing App Store Connect draft/build for review without building a new binary"
  lane :submit_existing_draft do
    api_key = app_store_connect_api_key(
      key_id:      ENV['ASC_KEY_ID'],
      issuer_id:   ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_PRIVATE_KEY']
    )

    release_notes = ENV['RELEASE_NOTES']
    has_release_notes = !(release_notes.nil? || release_notes.strip.empty?)

    deliver_options = {
      api_key:              api_key,
      app_identifier:       "app.dosuru",
      skip_binary_upload:   true,
      skip_screenshots:     true,
      skip_metadata:        !has_release_notes,
      submit_for_review:    true,
      automatic_release:    true,
      force:                true
    }

    deliver_options[:release_notes] = { "ja" => release_notes } if has_release_notes

    deliver(deliver_options)
  end
end
